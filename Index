<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Portal da Supervisão - Senac Portão - PR</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .senac-blue { background-color: #004587; }
        .senac-blue-text { color: #004587; }
        .senac-orange { background-color: #f37021; }
        .senac-orange-text { color: #f37021; }
        .senac-orange-hover:hover { background-color: #d9621a; }
        .senac-blue-hover:hover { background-color: #003366; }
        .glass-card { background: white; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03); border: 1px solid #e2e8f0; }
        
        .fab { position: fixed; bottom: 30px; right: 30px; border-radius: 50%; width: 60px; height: 60px; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1); display: flex; align-items: center; justify-content: center; cursor: pointer; transition: transform 0.2s; z-index: 50; }
        .fab:hover { transform: scale(1.05); }
        .fab-text { position: absolute; right: 75px; background: white; padding: 8px 12px; border-radius: 8px; font-weight: 500; font-size: 14px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); opacity: 0; transition: opacity 0.2s; white-space: nowrap; pointer-events: none;}
        .fab:hover .fab-text { opacity: 1; }

        .tab-btn { border-bottom: 3px solid transparent; transition: all 0.2s; }
        .tab-btn.active { border-bottom: 3px solid #f37021; color: #004587; font-weight: 700; }
        .hidden-section { display: none; }
        
        /* Ajuste de scrollbar para tabelas longas */
        .custom-scrollbar::-webkit-scrollbar { height: 8px; width: 8px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #94a3b8; }
    </style>
</head>
<body class="text-slate-800">

    <nav class="senac-blue text-white p-4 shadow-md flex justify-between items-center">
        <div class="flex items-center space-x-3">
            <div class="bg-white p-2 rounded text-senac-blue">
                <i class="fa-solid fa-graduation-cap text-2xl"></i>
            </div>
            <div>
                <h1 class="text-xl font-bold tracking-wide">Portal da Supervisão</h1>
                <p class="text-xs text-blue-200">Senac Portão - PR</p>
            </div>
        </div>
        <div class="flex items-center space-x-4">
            <div class="text-right hidden md:block">
                <p class="text-sm font-semibold">Michel Vieira Farias</p>
                <p class="text-xs text-blue-200">Analista Pedagógico</p>
            </div>
            <div class="h-10 w-10 bg-white text-senac-blue rounded-full flex items-center justify-center font-bold shadow-inner border-2 border-senac-orange">
                MV
            </div>
        </div>
    </nav>

    <main class="max-w-7xl mx-auto px-4 py-8">
        
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-6">
            <div class="glass-card p-5 lg:col-span-2 flex flex-col justify-between">
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-3"><i class="fa-solid fa-file-csv mr-2"></i> Fonte de Dados</h2>
                <div class="flex flex-col md:flex-row gap-4">
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Planilha Qualificação (Somente Status e Turma)</label>
                        <input type="file" id="upload-qual" accept=".csv" class="block w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-senac-blue hover:file:bg-blue-100 cursor-pointer border border-slate-200 rounded">
                    </div>
                    <div class="flex-1">
                        <label class="block text-xs font-semibold text-slate-600 mb-1">Planilha Técnica (Somente Status e Turma)</label>
                        <input type="file" id="upload-tec" accept=".csv" class="block w-full text-xs text-slate-500 file:mr-3 file:py-1.5 file:px-3 file:rounded file:border-0 file:text-xs file:font-semibold file:bg-blue-50 file:text-senac-blue hover:file:bg-blue-100 cursor-pointer border border-slate-200 rounded">
                    </div>
                </div>
                <div class="mt-3 flex justify-end">
                    <button onclick="handleUpload()" class="senac-blue senac-blue-hover text-white text-sm font-semibold py-2 px-4 rounded shadow transition-all flex items-center space-x-2">
                        <i class="fa-solid fa-cloud-arrow-up"></i>
                        <span>Processar Planilhas</span>
                    </button>
                </div>
            </div>

            <div class="glass-card p-5 border-l-4 border-l-senac-orange flex flex-col justify-between bg-orange-50/30">
                <h2 class="text-sm font-bold text-slate-500 uppercase tracking-wider mb-3"><i class="fa-solid fa-sliders mr-2"></i> Parâmetros de Cálculo</h2>
                <div class="space-y-3">
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-medium text-slate-700">Valor da Hora (R$)</label>
                        <input type="number" id="cfg-valor" value="3.75" step="0.01" class="w-24 px-2 py-1 border border-slate-300 rounded text-right text-sm font-semibold focus:outline-senac-orange">
                    </div>
                    <div class="flex items-center justify-between">
                        <label class="text-sm font-medium text-slate-700">Horas por Visita (h)</label>
                        <input type="number" id="cfg-tempo" value="0.5" step="0.1" class="w-24 px-2 py-1 border border-slate-300 rounded text-right text-sm font-semibold focus:outline-senac-orange">
                    </div>
                </div>
                <div class="mt-3">
                    <button onclick="aplicarParametros()" class="w-full bg-white border border-senac-orange text-senac-orange hover:bg-senac-orange hover:text-white text-sm font-semibold py-1.5 rounded transition-colors">
                        Aplicar e Recalcular
                    </button>
                </div>
            </div>
        </div>

        <div class="flex border-b border-slate-200 mb-6 space-x-8 px-2">
            <button id="tab-real" onclick="switchTab('real')" class="tab-btn active pb-3 text-slate-600 font-medium text-lg flex items-center">
                <i class="fa-solid fa-database mr-2"></i> Base Real
            </button>
            <button id="tab-simulador" onclick="switchTab('simulador')" class="tab-btn pb-3 text-slate-600 font-medium text-lg flex items-center">
                <i class="fa-solid fa-flask mr-2"></i> Simulador de Cenários
            </button>
        </div>

        <div id="section-simulador-controls" class="hidden-section glass-card p-6 mb-6 bg-indigo-50/50 border-l-4 border-indigo-500">
            <h2 class="text-lg font-bold text-indigo-900 mb-2"><i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Configurar Simulação de Alunos</h2>
            <p class="text-sm text-indigo-700 mb-4">Insira a quantidade total de alunos desejada. O sistema irá distribuí-los automaticamente pelas turmas e não utilizará os dados das planilhas nesta aba.</p>
            
            <div class="flex flex-col md:flex-row gap-6 items-end">
                <div class="flex-1">
                    <label class="block text-sm font-bold text-slate-700 mb-1">Total Alunos Qualificação (3 visitas)</label>
                    <input type="number" id="sim-alunos-qual" value="870" class="w-full px-4 py-2 border border-slate-300 rounded focus:outline-indigo-500 font-semibold text-lg">
                </div>
                <div class="flex-1">
                    <label class="block text-sm font-bold text-slate-700 mb-1">Total Alunos Técnica (6 visitas)</label>
                    <input type="number" id="sim-alunos-tec" value="300" class="w-full px-4 py-2 border border-slate-300 rounded focus:outline-indigo-500 font-semibold text-lg">
                </div>
                <button onclick="rodarSimulacao()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-6 rounded-lg shadow transition-all flex items-center space-x-2">
                    <i class="fa-solid fa-play"></i>
                    <span>Rodar Simulação</span>
                </button>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
            <div class="glass-card p-5 flex items-center space-x-4 border-b-4 border-blue-100">
                <div class="p-3 bg-blue-50 text-senac-blue rounded-full"><i class="fa-solid fa-users text-2xl"></i></div>
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Alunos Ativos</p>
                    <h3 class="text-2xl font-black text-slate-800" id="kpi-alunos">0</h3>
                </div>
            </div>
            <div class="glass-card p-5 flex items-center space-x-4 border-b-4 border-indigo-100">
                <div class="p-3 bg-indigo-50 text-indigo-600 rounded-full"><i class="fa-solid fa-clock text-2xl"></i></div>
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Carga Horária Total</p>
                    <h3 class="text-2xl font-black text-slate-800" id="kpi-horas">0h</h3>
                </div>
            </div>
            <div class="glass-card p-5 flex items-center space-x-4 border-b-4 border-orange-100">
                <div class="p-3 bg-orange-50 text-senac-orange rounded-full"><i class="fa-solid fa-money-bill-wave text-2xl"></i></div>
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Orçamento Base</p>
                    <h3 class="text-2xl font-black text-slate-800" id="kpi-orcamento">R$ 0,00</h3>
                </div>
            </div>
            <div class="glass-card p-5 flex items-center space-x-4 border-b-4 border-red-100">
                <div class="p-3 bg-red-50 text-red-600 rounded-full"><i class="fa-solid fa-triangle-exclamation text-2xl"></i></div>
                <div>
                    <p class="text-xs text-slate-500 font-bold uppercase tracking-wider">Turmas Estouradas</p>
                    <h3 class="text-2xl font-black text-red-600" id="kpi-estouradas">0</h3>
                </div>
            </div>
        </div>

        <div class="glass-card p-6 mb-8">
            <h2 class="text-lg font-bold text-slate-800 mb-4 flex items-center"><i class="fa-solid fa-chart-column mr-2 senac-blue-text"></i> Consumo de Horas por Turma <span class="text-sm font-normal text-slate-500 ml-2">(Teto Limitador: 100h)</span></h2>
            <div class="w-full h-80 relative">
                <canvas id="chartTurmas"></canvas>
            </div>
        </div>

        <div class="glass-card p-6 mb-8">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-lg font-bold text-slate-800 flex items-center"><i class="fa-solid fa-table-list mr-2 senac-blue-text"></i> Cálculo Financeiro e Auditoria por Turma</h2>
                <button onclick="exportarRelatorio()" class="text-sm font-bold text-senac-orange hover:text-orange-700 flex items-center transition bg-orange-50 px-4 py-2 rounded-md shadow-sm border border-orange-100">
                    <i class="fa-solid fa-file-export mr-2"></i> Exportar Orçamento
                </button>
            </div>
            <div class="overflow-x-auto h-[500px] border border-slate-200 rounded-lg custom-scrollbar">
                <table class="w-full text-sm text-left whitespace-nowrap">
                    <thead class="text-xs text-slate-700 uppercase bg-slate-100 sticky top-0 z-10 shadow-sm">
                        <tr>
                            <th class="px-4 py-4">Turma</th>
                            <th class="px-4 py-4">Modalidade</th>
                            <th class="px-4 py-4 text-center">Volume (Alunos)</th>
                            <th class="px-4 py-4 text-center">Horas Exigidas</th>
                            <th class="px-4 py-4 text-center">Saldo (Teto 100h)</th>
                            <th class="px-4 py-4 text-center">Impacto Financeiro</th>
                            <th class="px-4 py-4 text-center">Auditoria</th>
                        </tr>
                    </thead>
                    <tbody id="tbody-turmas" class="divide-y divide-slate-100">
                        </tbody>
                </table>
            </div>
        </div>
    </main>

    <div class="fab senac-orange text-white text-2xl hover:shadow-xl transition" onclick="alert('Iniciando atendimento de suporte da Supervisão...')">
        <i class="fa-solid fa-headset"></i>
        <span class="fab-text text-slate-700">Falar com Suporte</span>
    </div>

    <script>
        // Variáveis Globais Configuração
        let valorHoraConfig = 3.75;
        let horasPorVisitaConfig = 0.5;
        
        let chartInstance = null;
        let turmasDataForExport = [];
        let currentMode = 'real';
        
        // Base de dados carregada via upload
        let rawQualData = [];
        let rawTecData = [];

        // Inicializa o Dashboard vazio se não houver arquivo
        document.addEventListener('DOMContentLoaded', () => {
            updateDashboard(0, 0, []);
        });
        
        function aplicarParametros() {
            const valInput = parseFloat(document.getElementById('cfg-valor').value.replace(',', '.'));
            const tempoInput = parseFloat(document.getElementById('cfg-tempo').value.replace(',', '.'));
            
            if(!isNaN(valInput) && valInput > 0) valorHoraConfig = valInput;
            if(!isNaN(tempoInput) && tempoInput > 0) horasPorVisitaConfig = tempoInput;
            
            if(currentMode === 'real') {
                processRealData();
            } else {
                rodarSimulacao();
            }
        }

        async function handleUpload() {
            const qualFile = document.getElementById('upload-qual').files[0];
            const tecFile = document.getElementById('upload-tec').files[0];
            
            if(!qualFile && !tecFile) {
                alert("Por favor, selecione ao menos uma planilha (.csv) para carregar.");
                return;
            }
            
            if(qualFile) {
                const textQual = await qualFile.text();
                rawQualData = Papa.parse(textQual, {header: true, skipEmptyLines: true}).data;
            }
            
            if(tecFile) {
                const textTec = await tecFile.text();
                rawTecData = Papa.parse(textTec, {header: true, skipEmptyLines: true}).data;
            }
            
            if(currentMode === 'simulador') switchTab('real');
            else processRealData();
        }

        function switchTab(mode) {
            currentMode = mode;
            document.getElementById('tab-real').classList.remove('active');
            document.getElementById('tab-simulador').classList.remove('active');
            
            if(mode === 'real') {
                document.getElementById('tab-real').classList.add('active');
                document.getElementById('section-simulador-controls').classList.add('hidden-section');
                processRealData();
            } else {
                document.getElementById('tab-simulador').classList.add('active');
                document.getElementById('section-simulador-controls').classList.remove('hidden-section');
                rodarSimulacao();
            }
        }

        function processRealData() {
            let turmasDict = {};
            let totalAlunos = 0;
            
            // Processamento Limpo: Apenas Lemos Turma e Status
            
            // Qualificação (3 Visitas)
            if(rawQualData && rawQualData.length > 0) {
                rawQualData.forEach(row => {
                    if(row.Status && row.Status.trim().toUpperCase() === 'ATIVO') {
                        totalAlunos++;
                        let turma = row.Turma || 'Sem Turma Identificada';
                        if(!turmasDict[turma]) {
                            turmasDict[turma] = { turma: turma, tipo: 'Qualificação', alunos: 0, horasTotais: 0 };
                        }
                        turmasDict[turma].alunos++;
                        turmasDict[turma].horasTotais += (3 * horasPorVisitaConfig);
                    }
                });
            }
            
            // Técnica (6 Visitas)
            if(rawTecData && rawTecData.length > 0) {
                rawTecData.forEach(row => {
                    if(row.Status && row.Status.trim().toUpperCase() === 'ATIVO') {
                        totalAlunos++;
                        let turma = row.Turma || 'Sem Turma Identificada';
                        if(!turmasDict[turma]) {
                            turmasDict[turma] = { turma: turma, tipo: 'Técnica', alunos: 0, horasTotais: 0 };
                        }
                        turmasDict[turma].alunos++;
                        turmasDict[turma].horasTotais += (6 * horasPorVisitaConfig);
                    }
                });
            }
            
            let horasPainelGeral = Object.values(turmasDict).reduce((acc, t) => acc + t.horasTotais, 0);
            updateDashboard(totalAlunos, horasPainelGeral, Object.values(turmasDict));
        }
        
        function rodarSimulacao() {
            const numQual = parseInt(document.getElementById('sim-alunos-qual').value) || 0;
            const numTec = parseInt(document.getElementById('sim-alunos-tec').value) || 0;
            
            // Tenta usar turmas reais carregadas, senao gera genericas para simulacao
            let turmasQual = [...new Set(rawQualData.map(d => d.Turma))].filter(t => t);
            let turmasTec = [...new Set(rawTecData.map(d => d.Turma))].filter(t => t);
            
            if(turmasQual.length === 0) turmasQual = Array.from({length: 25}, (_, i) => `SIM-QUAL-${i+1}`);
            if(turmasTec.length === 0) turmasTec = Array.from({length: 9}, (_, i) => `SIM-TEC-${i+1}`);
            
            let simulatedData = [];
            let totalAlunos = numQual + numTec;
            let totalHoras = 0;
            
            if(numQual > 0) {
                let baseQual = Math.floor(numQual / turmasQual.length);
                let remQual = numQual % turmasQual.length;
                turmasQual.forEach((t, i) => {
                    let alunos = baseQual + (i < remQual ? 1 : 0);
                    if(alunos > 0) {
                        let horas = alunos * 3 * horasPorVisitaConfig;
                        totalHoras += horas;
                        simulatedData.push({ turma: t, tipo: 'Qualificação', alunos: alunos, horasTotais: horas });
                    }
                });
            }
            
            if(numTec > 0) {
                let baseTec = Math.floor(numTec / turmasTec.length);
                let remTec = numTec % turmasTec.length;
                turmasTec.forEach((t, i) => {
                    let alunos = baseTec + (i < remTec ? 1 : 0);
                    if(alunos > 0) {
                        let horas = alunos * 6 * horasPorVisitaConfig;
                        totalHoras += horas;
                        simulatedData.push({ turma: t, tipo: 'Técnica', alunos: alunos, horasTotais: horas });
                    }
                });
            }
            
            updateDashboard(totalAlunos, totalHoras, simulatedData);
        }

        function updateDashboard(totalAlunos, totalHoras, turmasArray) {
            let orcamentoPrevisto = totalHoras * valorHoraConfig;
            
            turmasArray.sort((a,b) => b.horasTotais - a.horasTotais);
            turmasDataForExport = turmasArray;
            
            let turmasEstouradas = turmasArray.filter(t => t.horasTotais > 100).length;
            
            document.getElementById('kpi-alunos').innerText = totalAlunos;
            document.getElementById('kpi-horas').innerText = totalHoras.toFixed(1) + 'h';
            document.getElementById('kpi-orcamento').innerText = 'R$ ' + orcamentoPrevisto.toLocaleString('pt-BR', {minimumFractionDigits: 2});
            document.getElementById('kpi-estouradas').innerText = turmasEstouradas;
            
            renderChart(turmasArray);
            renderTableTurmas(turmasArray);
        }

        function renderChart(turmasArray) {
            const ctx = document.getElementById('chartTurmas').getContext('2d');
            if(chartInstance) chartInstance.destroy();
            
            // Renderiza apenas se houver dados
            if(turmasArray.length === 0) return;
            
            let chartData = turmasArray.slice(0, 30); 
            
            let labels = chartData.map(t => t.turma);
            let data = chartData.map(t => t.horasTotais);
            let bgColors = chartData.map(t => t.horasTotais > 100 ? '#ef4444' : '#004587');
            let limitLine = chartData.map(t => 100);

            chartInstance = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            type: 'line',
                            label: 'Teto Legal (100h)',
                            data: limitLine,
                            borderColor: '#f37021',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            fill: false,
                            pointRadius: 0
                        },
                        {
                            type: 'bar',
                            label: 'Horas Exigidas',
                            data: data,
                            backgroundColor: bgColors,
                            borderRadius: 4
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: {usePointStyle: true} },
                        tooltip: { callbacks: { label: function(context) { return context.raw.toFixed(1) + ' horas'; } } }
                    },
                    scales: { y: { beginAtZero: true, suggestedMax: 120 } }
                }
            });
        }

        function renderTableTurmas(turmasArray) {
            const tbody = document.getElementById('tbody-turmas');
            tbody.innerHTML = '';
            
            if(turmasArray.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="px-4 py-8 text-center text-slate-500">Faça o upload dos arquivos ou use o Simulador para visualizar os dados.</td></tr>';
                return;
            }
            
            turmasArray.forEach(t => {
                let saldo = 100 - t.horasTotais;
                let estourou = saldo < 0;
                let orcamento = t.horasTotais * valorHoraConfig;
                
                let tr = document.createElement('tr');
                tr.className = "hover:bg-slate-50 transition border-b border-slate-100";
                if(estourou) tr.classList.add('bg-red-50', 'hover:bg-red-100');
                
                tr.innerHTML = `
                    <td class="px-4 py-4 font-bold text-slate-800">${t.turma}</td>
                    <td class="px-4 py-4 text-slate-600"><span class="px-3 py-1 bg-slate-200 rounded-full text-xs font-semibold">${t.tipo}</span></td>
                    <td class="px-4 py-4 text-center text-slate-700 font-medium">${t.alunos}</td>
                    <td class="px-4 py-4 text-center font-black ${estourou ? 'text-red-600' : 'text-senac-blue'}">${t.horasTotais.toFixed(1)} h</td>
                    <td class="px-4 py-4 text-center font-bold ${estourou ? 'text-red-600' : 'text-emerald-600'}">${saldo.toFixed(1)} h</td>
                    <td class="px-4 py-4 text-center text-slate-800 font-bold">R$ ${orcamento.toLocaleString('pt-BR', {minimumFractionDigits: 2})}</td>
                    <td class="px-4 py-4 text-center">
                        ${estourou 
                            ? '<span class="px-3 py-1 bg-red-600 text-white rounded text-xs font-bold shadow-sm"><i class="fa-solid fa-circle-exclamation mr-1"></i>Ajustar Turma</span>' 
                            : '<span class="px-3 py-1 bg-emerald-500 text-white rounded text-xs font-bold shadow-sm"><i class="fa-solid fa-check mr-1"></i>Dentro do Teto</span>'}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        function exportarRelatorio() {
            if(turmasDataForExport.length === 0) return;
            
            let prefix = currentMode === 'real' ? 'Base_Real' : 'Simulacao';
            let csvContent = "data:text/csv;charset=utf-8,";
            csvContent += "Turma;Modalidade;Alunos;Horas Exigidas;Saldo (100h);Orcamento (R$);Auditoria\n";
            
            turmasDataForExport.forEach(t => {
                let saldo = 100 - t.horasTotais;
                let status = saldo < 0 ? "Requer Ajuste" : "Dentro do Teto";
                let orcamento = t.horasTotais * valorHoraConfig;
                
                let row = `${t.turma};${t.tipo};${t.alunos};${t.horasTotais.toFixed(1).replace('.',',')};${saldo.toFixed(1).replace('.',',')};${orcamento.toFixed(2).replace('.',',')};${status}`;
                csvContent += row + "\n";
            });
            
            const encodedUri = encodeURI(csvContent);
            const link = document.createElement("a");
            link.setAttribute("href", encodedUri);
            link.setAttribute("download", `Orcamento_Supervisao_${prefix}.csv`);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }
    </script>
</body>
</html>
